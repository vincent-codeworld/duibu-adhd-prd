HTTP_ADDR=:8080
DATABASE_URL=postgres://duibu:duibu@localhost:5432/duibu?sslmode=disable
# memory = ephemeral in-process store (unit tests / no Docker)
# postgres = default; runs migrations on startup
STORE_DRIVER=postgres
JWT_SECRET=change-me-in-production
AUTH_MODE=stub

# --- Sign in with Apple (AUTH_MODE=apple) ---
# Required to verify identityToken: audience must match the aud claim.
# Native iOS: APPLE_CLIENT_ID = app Bundle ID (MVP: com.stepbuddy.app)
APPLE_CLIENT_ID=com.stepbuddy.app
# Optional extra audiences (comma-separated), e.g. Services ID for web
APPLE_CLIENT_IDS=
# Optional: used later for authorization code → refresh token / client_secret.
# Not required for identityToken verify on login.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Provide ONE of: inline PEM or path to AuthKey_XXX.p8 from Apple Developer
APPLE_PRIVATE_KEY_PEM=
APPLE_PRIVATE_KEY_PATH=

AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
INVITE_CODE_MAX_FAILS_PER_HOUR=10
UPLOAD_DIR=./data/screenshots
